{"files": [{"id": 51316509, "name": "jp4c07397_si_001.pdf", "size": 1702349, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/51316509", "supplied_md5": "eb375fb1f7edf3cd141d11d04c144a1c", "computed_md5": "eb375fb1f7edf3cd141d11d04c144a1c", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 20456262, "full_name": "Yoshiki Hasukawa", "first_name": "Yoshiki", "last_name": "Hasukawa", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14835006, "full_name": "Fernando Garcia-Escobar", "first_name": "Fernando", "last_name": "Garcia-Escobar", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1409992, "full_name": "Keisuke Takahashi", "first_name": "Keisuke", "last_name": "Takahashi", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3107373, "full_name": "Lauren Takahashi", "first_name": "Lauren", "last_name": "Takahashi", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Multidimensional_Catalysis_Data_Representation_for_Designing_Oxidative_Coupling_of_Methane_Catalysts/28068057", "download_disabled": false, "description": "The oxidative coupling of methane reaction is important\nin the\nchemical industry from the perspective of an energy source. Although\nit is difficult to increase C<sub>2</sub> yield due to the stability\nof methane and formation of CO<sub><i>x</i></sub> byproducts\nat high temperatures, informatics has been proven to be a useful approach\nfor effective OCM catalyst design. However, informatics using machine\nlearning in complex environments, such as heterogeneous catalysts,\nhas a black box problem. Therefore, graph theory is applied to the\nconstruction of complex networks in order to clarify the relationships\nbetween multiple variables and design catalysts based on the analysis\nof constructed networks. All proposed catalysts are demonstrated to\nbe active in experiments, indicating that catalyst design based on\nthe constructed network is useful and applicable to complex reaction\nsystems.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 1702349, "created_date": "2024-12-20T02:31:04Z", "modified_date": "2024-12-20T02:31:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["catalyst design based", "black box problem", "design catalysts based", "designing oxidative coupling", "complex reaction systems", "2 </ sub", "oxidative coupling", "x </", "complex networks", "complex environments", "proposed catalysts", "heterogeneous catalysts", "methane reaction", "yield due", "sub ><", "multiple variables", "increase c", "high temperatures", "graph theory", "energy source", "constructed networks", "constructed network", "chemical industry", "></ sub"], "keywords": ["catalyst design based", "black box problem", "design catalysts based", "designing oxidative coupling", "complex reaction systems", "2 </ sub", "oxidative coupling", "x </", "complex networks", "complex environments", "proposed catalysts", "heterogeneous catalysts", "methane reaction", "yield due", "sub ><", "multiple variables", "increase c", "high temperatures", "graph theory", "energy source", "constructed networks", "constructed network", "chemical industry", "></ sub"], "categories": [{"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 146, "title": "Space Science", "parent_id": 43, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 8, "title": "Microbiology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 24, "title": "Evolutionary Biology", "parent_id": 48, "p